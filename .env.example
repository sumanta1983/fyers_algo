# Copy this file to .env and fill in real values. .env is gitignored.
# Note: no spaces around =, no quotes (so Node, Python, and docker-compose all parse it).


# ---- Fyers API ----
FYERS_CLIENT_ID=""
FYERS_SECRET_KEY=""
FYERS_REDIRECT_URL="https://trade.fyers.in/api-login/redirect-uri/index.html"
FYERS_RESPONSE_TYPE="code"
FYERS_STATE="sample_state"
FYERS_GRANT_TYPE="authorization_code"

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fyers_algo

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ---- App ----
NODE_BACKEND_PORT=4000
TZ=Asia/Kolkata

# Comma-separated symbols in Fyers format (EXCHANGE:SYMBOL-SERIES).
# Used by node_backend on boot to subscribe.
WATCHLIST=NSE:RELIANCE-EQ,NSE:TCS-EQ,NSE:INFY-EQ,NSE:HDFCBANK-EQ,NSE:ICICIBANK-EQ
