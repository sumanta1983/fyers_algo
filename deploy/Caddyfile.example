# /etc/caddy/Caddyfile — fyers_algo dashboard + API
#
# Two subdomains, both behind basic auth, both auto-TLS via Let's Encrypt.
# Caddy handles WebSocket upgrades transparently in reverse_proxy.
#
# 1. Replace <yourdomain> with your real domain (e.g. example.com).
# 2. Replace <bcrypt-hash> with the output of `caddy hash-password`.
#    Use the SAME hash on both blocks (or set different credentials per block).
# 3. sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile
# 4. sudo systemctl reload caddy

{
    # Email for ACME registration / cert-expiry notices.
    email admin@<yourdomain>
}

dashboard.<yourdomain> {
    encode zstd gzip
    basicauth {
        algo <bcrypt-hash>
    }
    # Next.js production server
    reverse_proxy 127.0.0.1:3000
}

api.<yourdomain> {
    encode gzip
    basicauth {
        algo <bcrypt-hash>
    }
    # Node Fastify (HTTP routes + /ws/signals WebSocket).
    # Caddy auto-detects the Upgrade header and proxies WS correctly.
    reverse_proxy 127.0.0.1:4000
}
